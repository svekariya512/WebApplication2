<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="WebApplication2.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>CinePulse</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { background: #111111; }
        body { margin: 0; padding: 0; min-height: 100vh; background: #111111; color: #ffffff; font-family: Arial, Helvetica, sans-serif; }
        form { min-height: 100vh; background: #111111; }

        /* SIDEBAR */
        .sidebar {
            position: fixed; left: 0; top: 0;
            width: 230px; height: 100vh;
            background: #191919;
            border-right: 1px solid #303030;
            padding: 22px 14px;
            z-index: 1000;
        }
        .logo { display: flex; align-items: center; gap: 10px; padding-left: 12px; margin-bottom: 28px; }
        .logo-icon { width: 32px; height: 32px; color: #FFC3B9; flex-shrink: 0; }
        .logo-text { display: flex; flex-direction: column; }
        .logo-title { color: #FFC3B9; font-size: 22px; font-weight: bold; line-height: 22px; }
        .logo-subtitle { display: block; color: #999999; font-size: 10px; margin-top: 3px; }

        .menu { list-style: none; margin: 0; padding: 0; }
        .menu li { margin-bottom: 5px; }
        .menu a {
            width: 100%; height: 42px;
            display: flex; align-items: center; gap: 14px;
            padding: 0 13px;
            color: #c8c8c8; text-decoration: none; font-size: 14px;
            border-radius: 5px; transition: all 0.2s ease;
        }
        .menu a:hover { background: #383838; color: #ff3333 !important; }
        .menu a.active { background: #383838; color: #ff3333 !important; }
        .menu a.active .icon { color: #ff3333; }
        .icon { width: 20px; min-width: 20px; text-align: center; color: #c8c8c8; font-size: 16px; }

        .logout {
            position: absolute; left: 14px; right: 14px; bottom: 20px;
            padding-top: 15px; border-top: 1px solid #333333;
        }
        .logout a {
            height: 42px; display: flex; align-items: center; gap: 14px;
            padding: 0 13px; color: #ff8585; text-decoration: none; font-size: 14px;
            border-radius: 5px; transition: 0.2s;
        }
        .logout a:hover { background: #383838; color: #ff3333; }

        /* MAIN AREA */
        .main-area { margin-left: 230px; min-height: 100vh; background: #111111; }

        /* TOP HEADER */
        .cine-header {
            width: 100%; height: 82px;
            background: #111111;
            border-bottom: 1px solid #242424;
            display: flex; align-items: center;
            padding: 0 25px; gap: 20px;
            position: relative;
        }
        .hamburger-menu {
            display: flex; flex-direction: column; justify-content: center;
            gap: 4px; width: 24px; height: 24px;
            cursor: pointer; flex-shrink: 0;
        }
        .hamburger-menu span {
            display: block; width: 20px; height: 2px;
            background: #FFC3B9; border-radius: 2px;
            transition: 0.2s;
        }
        .hamburger-menu:hover span { background: #ffb0a3; }

        .header-search-area {
            flex-grow: 1;
            display: flex; justify-content: center; align-items: center;
        }
        .header-search {
            width: 100%; max-width: 380px; height: 38px;
            background: #1E1E1E;
            border: 1px solid #292929;
            border-radius: 7px;
            display: flex; align-items: center;
            padding: 0 15px;
        }
        .header-search-icon { color: #FFC3B9; font-size: 14px; margin-right: 10px; }
        .header-search input {
            width: 100%; border: none; outline: none;
            background: transparent; color: #eeeeee; font-size: 12px;
        }
        .header-search input::placeholder { color: #777777; }

        .header-icons { display: flex; align-items: center; gap: 19px; flex-shrink: 0; }

        .header-icon-button {
            position: relative; width: 28px; height: 28px;
            border: none; background: transparent;
            color: #FFC3B9; padding: 0;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: 0.2s;
        }
        .header-icon-button:hover { opacity: 0.8; transform: scale(1.08); }

        .bell-icon { width: 21px; height: 21px; }
        .notification-dot {
            position: absolute; width: 7px; height: 7px;
            background: #FF2A2A; border-radius: 50%;
            top: 1px; right: 1px;
            border: 1px solid #111111;
        }
        .help-icon { width: 20px; height: 20px; }

        /* AVATAR */
        .avatar-container {
            width: 31px; height: 31px;
            border-radius: 50%;
            border: 1px solid rgba(255, 195, 185, 0.55);
            overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            background: radial-gradient(circle at 50% 35%, #4a1717 0%, #261313 35%, #151515 75%, #0d0d0d 100%);
            cursor: pointer;
            transition: 0.2s;
        }
        .avatar-container:hover {
            border-color: #FFC3B9;
            transform: scale(1.05);
            box-shadow: 0 0 12px rgba(255, 195, 185, 0.35);
        }
        .avatar-img {
            width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 35%, rgba(110, 35, 35, 0.75), rgba(20, 20, 20, 0.95) 65%);
        }

        /* CONTENT */
        .content {
            width: 100%;
            min-height: calc(100vh - 82px);
            background: #111111;
        }

        /* LOGOUT MODAL */
        .logout-overlay {
            display: none;
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.58);
            z-index: 99999;
            align-items: center; justify-content: center;
        }
        .logout-overlay.show { display: flex; }
        .logout-modal {
            width: 218px;
            background: #202020;
            border: 1px solid #303030;
            border-radius: 7px;
            padding: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.60);
            text-align: center;
        }
        .logout-modal-icon {
            width: 30px; height: 30px;
            margin: 0 auto 11px auto;
            border-radius: 50%;
            background: #303030;
            display: flex; align-items: center; justify-content: center;
            color: #ff9d95; font-size: 16px;
        }
        .logout-modal-title { color: #eeeeee; font-size: 10px; font-weight: 600; margin-bottom: 8px; }
        .logout-modal-description { color: #a0a0a0; font-size: 7px; line-height: 12px; margin: 0 auto 13px auto; max-width: 180px; }
        .logout-modal-actions { display: flex; justify-content: center; gap: 7px; }
        .logout-cancel {
            width: 87px; height: 22px;
            background: #202020; border: 1px solid #3c3c3c;
            border-radius: 4px; color: #d0d0d0; font-size: 7px;
            cursor: pointer;
        }
        .logout-cancel:hover { background: #292929; color: #ffffff; }
        .logout-confirm {
            width: 87px; height: 22px;
            background: #ff171f; border: 1px solid #ff171f;
            border-radius: 4px; color: #ffffff; font-size: 7px;
            cursor: pointer;
        }
        .logout-confirm:hover { background: #df1118; border-color: #df1118; }

        @media screen and (max-width: 900px) {
            .sidebar { width: 200px; }
            .main-area { margin-left: 200px; }
        }
        @media screen and (max-width: 700px) {
            .header-search-area { display: none; }
            .header-icons { gap: 10px; }
        }
    </style>
</head>

<body>
<form id="form1" runat="server">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="logo">
            <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4H20C21.1 4 22 4.9 22 6V8H2V6C2 4.9 2.9 4 4 4ZM2 10H22V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V10ZM6 12V14H8V12H6ZM10 12V14H12V12H10ZM14 12V14H16V12H14ZM18 12V14H20V12H18ZM6 16V18H8V16H6ZM10 16V18H12V16H10ZM14 16V18H16V16H14ZM18 16V18H20V16H18Z"/>
            </svg>
            <div class="logo-text">
                <div class="logo-title">CinePulse</div>
                <span class="logo-subtitle">Global Control Center</span>
            </div>
        </div>

        <ul class="menu">
            <li><a href="home.aspx"><span class="icon">▦</span><span>Dashboard</span></a></li>
            <li><a href="Tickets.aspx"><span class="icon">🎟</span><span>Tickets</span></a></li>
            <li><a href="Movies.aspx"><span class="icon">▣</span><span>Movies</span></a></li>
            <li><a href="Theater.aspx"><span class="icon">▤</span><span>Theater</span></a></li>
            <li><a href="Booking.aspx"><span class="icon">▣</span><span>Bookings</span></a></li>
            <li><a href="Users.aspx"><span class="icon">♙</span><span>Users</span></a></li>
            <li><a href="About.aspx"><span class="icon">ⓘ</span><span>Manage About</span></a></li>
            <li><a href="Reviews.aspx"><span class="icon">☆</span><span>Reviews</span></a></li>
            <li><a href="Contact.aspx"><span class="icon">✉</span><span>Contact</span></a></li>
            <li><a href="Profile.aspx"><span class="icon">♙</span><span>Profile</span></a></li>
            <li><a href="Settings.aspx"><span class="icon">⚙</span><span>Settings</span></a></li>
        </ul>

        <div class="logout">
            <a href="javascript:void(0);" onclick="openLogoutModal();">
                <span class="icon">⇥</span>
                <span>Logout</span>
            </a>
        </div>
    </div>


    <!-- MAIN AREA -->
    <div class="main-area">

        <!-- TOP HEADER -->
        <div class="cine-header">

            <div class="hamburger-menu" title="Menu">
                <span></span><span></span><span></span>
            </div>

            <div class="header-search-area">
                <div class="header-search">
                    <span class="header-search-icon">⌕</span>
                    <input type="text" placeholder="Search messages..." />
                </div>
            </div>

            <div class="header-icons">

                <!-- NOTIFICATION (Click → Notification.aspx) -->
                <button type="button" class="header-icon-button" title="Notifications" onclick="openNotificationPage();">
                    <svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="notification-dot"></span>
                </button>

                <!-- HELP (Click → Help.aspx) -->
                <button type="button" class="header-icon-button" title="Help" onclick="openHelpPage();">
                    <svg class="help-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </button>

                <!-- AVATAR (Click → Profile.aspx) -->
                <div class="avatar-container" title="Profile" onclick="openProfilePage();">
                    <div class="avatar-img"></div>
                </div>

            </div>

        </div>

        <!-- PAGE CONTENT -->
        <div class="content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>

    </div>


    <!-- LOGOUT MODAL -->
    <div id="logoutOverlay" class="logout-overlay">
        <div class="logout-modal" onclick="event.stopPropagation();">
            <div class="logout-modal-icon">⇥</div>
            <div class="logout-modal-title">LogOut of CinePlus</div>
            <div class="logout-modal-description">
                Are you sure you want to log out?
                You will need to sign back in to
                access your profile and tickets.
            </div>
            <div class="logout-modal-actions">
                <button type="button" class="logout-cancel" onclick="closeLogoutModal();">Cancel</button>
                <button type="button" class="logout-confirm" onclick="confirmLogout();">Logout</button>
            </div>
        </div>
    </div>


    <!-- JAVASCRIPT -->
    <script type="text/javascript">

        /* ACTIVE MENU */
        document.addEventListener("DOMContentLoaded", function () {
            var currentUrl = window.location.href.split("?")[0].split("#")[0].toLowerCase();
            var menuLinks = document.querySelectorAll(".menu a");
            menuLinks.forEach(function (link) {
                link.classList.remove("active");
                var linkUrl = new URL(link.href, window.location.href).href.split("?")[0].split("#")[0].toLowerCase();
                if (linkUrl === currentUrl) { link.classList.add("active"); }
            });
        });

        /* ⭐ NOTIFICATION ICON CLICK */
        function openNotificationPage() {
            window.location.href = "Notification.aspx";
        }

        /* ⭐ HELP ICON CLICK */
        function openHelpPage() {
            window.location.href = "Help.aspx";
        }

        /* ⭐ PROFILE ICON CLICK */
        function openProfilePage() {
            window.location.href = "Profile.aspx";
        }

        /* LOGOUT */
        function openLogoutModal() {
            var overlay = document.getElementById("logoutOverlay");
            if (overlay) { overlay.classList.add("show"); }
        }
        function closeLogoutModal() {
            var overlay = document.getElementById("logoutOverlay");
            if (overlay) { overlay.classList.remove("show"); }
        }
        function confirmLogout() {
            window.location.href = "Login.aspx";
        }

        document.addEventListener("click", function (event) {
            var overlay = document.getElementById("logoutOverlay");
            if (!overlay) return;
            if (event.target === overlay) { closeLogoutModal(); }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") { closeLogoutModal(); }
        });

    </script>

</form>
</body>
</html>